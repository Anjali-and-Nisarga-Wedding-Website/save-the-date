# macOS Finder metadata
.DS_Store

# Image originals — never commit raw camera/phone files to the deploy
# bundle. Originals live at ../_project-context/photos/originals/
# outside this repo; these patterns are defense-in-depth in case
# anything raw ever slips into site/.
**/originals/
*.heic
*.HEIC

# Editor / IDE
.idea/
*.iml
.vscode/

# Node (no build step today, but defensive in case we add one)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
